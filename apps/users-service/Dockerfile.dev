# Development Dockerfile with hot reload
FROM node:18-slim

# Install required packages for Prisma
RUN apt-get update && apt-get install -y openssl procps && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install nodemon globally for hot reloading
RUN npm install -g nodemon

# Copy package files
COPY package*.json ./
COPY turbo.json ./
COPY apps/users-service/package*.json ./apps/users-service/
COPY apps/users-service/prisma ./apps/users-service/prisma
COPY apps/users-service/tsconfig*.json ./apps/users-service/
COPY apps/users-service/nest-cli.json ./apps/users-service/
COPY apps/users-service/src ./apps/users-service/src
COPY packages/ ./packages/
COPY apps/users-service/.env ./apps/users-service/.env
COPY apps/users-service/start-dev.sh ./apps/users-service/start-dev.sh

# Make start script executable and fix line endings
RUN chmod +x ./apps/users-service/start-dev.sh && \
    sed -i 's/\r$//' ./apps/users-service/start-dev.sh


# Install all dependencies (including dev dependencies)
RUN npm install

# Build shared packages (only @repo/common now)
RUN npm run build --workspace=@repo/common --if-present || true

# Generate Prisma Client for users-service
WORKDIR /app/apps/users-service
RUN npx prisma generate

# Go back to root
WORKDIR /app

EXPOSE 3001

# Use start script for proper initialization and hot reload
CMD ["/app/apps/users-service/start-dev.sh"]
