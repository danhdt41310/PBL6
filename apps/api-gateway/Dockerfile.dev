# Development Dockerfile with hot reload
FROM node:18-alpine

WORKDIR /app

# Install nodemon globally for hot reloading
RUN npm install -g nodemon

# Copy package files
COPY package*.json ./
COPY turbo.json ./
COPY apps/api-gateway/package*.json ./apps/api-gateway/
COPY apps/api-gateway/tsconfig*.json ./apps/api-gateway/
COPY apps/api-gateway/nest-cli.json ./apps/api-gateway/
COPY apps/api-gateway/src ./apps/api-gateway/src
COPY packages/ ./packages/
COPY apps/api-gateway/prisma ./apps/api-gateway/prisma
COPY apps/api-gateway/.env ./apps/api-gateway/.env
COPY apps/api-gateway/start-dev.sh ./apps/api-gateway/start-dev.sh

# Make start script executable and fix line endings
RUN chmod +x ./apps/api-gateway/start-dev.sh && \
    sed -i 's/\r$//' ./apps/api-gateway/start-dev.sh

# Install all dependencies (including dev dependencies)
RUN npm install

# Build shared packages (@repo/common)
RUN npm run build --workspace=@repo/common --if-present || true

WORKDIR /app/apps/api-gateway
RUN npx prisma generate

# Go back to root
WORKDIR /app

EXPOSE 3000

# Use start script for proper initialization and hot reload
CMD ["/app/apps/api-gateway/start-dev.sh"]
